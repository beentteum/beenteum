# BEENTEUM Backend 환경변수 예시
# - 실제 값은 이 파일에 쓰지 않는다. 각자 로컬 환경변수 / IDE Run Configuration / 서버 환경에 설정한다.
# - 로컬: 이 파일을 backend/.env 로 복사해 값을 채우면 서버가 자동으로 읽는다
#   (application.yml 의 spring.config.import). .env 는 .gitignore 로 커밋되지 않는다.
# - 운영: 서버/컨테이너 환경변수로 주입한다.
#
# 표기: [필수] 모든 Profile 필수 / [prod 필수] local 은 기본값 있음 / [선택] 비어 있어도 기동 가능

# ---- Profile ----
# [선택] local(기본) | prod
SPRING_PROFILES_ACTIVE=local

# ---- PostgreSQL + PostGIS ---- (DB 담당자 결과 확정 후 값 공유)
# [필수] 예: jdbc:postgresql://localhost:5432/<db명>
DB_URL=
# [필수]
DB_USERNAME=
# [필수]
DB_PASSWORD=

# ---- Flyway 마이그레이션 계정 ----
# [local/prod 필수] DB 스키마 변경 권한이 있는 계정
# 애플리케이션 DB 계정과 분리하여 사용
FLYWAY_USER=
FLYWAY_PASSWORD=

# ---- Redis ----
# [prod 필수] local 기본값 localhost
REDIS_HOST=
# [선택] 기본값 6379
REDIS_PORT=
# [선택] 비밀번호 없으면 비워둠
REDIS_PASSWORD=

# ---- JWT ----
# [필수] Base64 인코딩된 32byte 이상 키. 생성: openssl rand -base64 32
#        로컬/운영 키는 서로 다르게, 운영 키는 공유 채널에 올리지 않는다.
JWT_SECRET=
# [선택] Access Token 유효기간, 기본값 30m (예: 15m, 1h)
JWT_ACCESS_TOKEN_EXPIRATION=

# ---- CORS ----
# [prod 필수] 콤마 구분 Frontend Origin 목록. local 기본값 http://localhost:5173
CORS_ALLOWED_ORIGINS=

# ---- 외부 서비스 ---- (해당 기능 구현 전까지 비워도 됨)
# [선택] Kakao Local API REST API 키
KAKAO_REST_API_KEY=
# [선택] 공공데이터포털 서비스 키
PUBLIC_DATA_SERVICE_KEY=
